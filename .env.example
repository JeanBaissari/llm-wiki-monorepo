# LLM Wiki — Environment Configuration
# Copy to .env and fill in your values.
# 
# All fields are optional. The system auto-detects the best available
# provider based on your environment (Hermes session, API keys, etc.).

# ── Provider selection ─────────────────────────────────────────────────────
# LLM_WIKI_PROVIDER=opencode  # agent-native (no key needed — auto-detected in Hermes)
# LLM_WIKI_PROVIDER=openai    # requires OPENAI_API_KEY
# LLM_WIKI_PROVIDER=anthropic # requires ANTHROPIC_API_KEY
# LLM_WIKI_PROVIDER=deepseek  # requires DEEPSEEK_API_KEY
# LLM_WIKI_PROVIDER=together  # requires TOGETHER_API_KEY

# ── API keys (only needed for external providers) ──────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...
# TOGETHER_API_KEY=...

# ── Offline / agent-loop mode ──────────────────────────────────────────────
# When no external API keys are set and you're not inside a Hermes session,
# the system prints prompts to stderr and waits for a response file.
# LLM_WIKI_RESPONSE_FILE=/tmp/llm-wiki-response.txt

# ── Agent-native mode (opencode provider) ──────────────────────────────────
# Auto-detected when running inside Hermes, Claude Code, Codex, or any
# AI-managed terminal. No API key needed — uses the agent's own model.
#
# Manual override (for non-Hermes agent environments):
# LLM_WIKI_AGENT_MODE=1
#
# Advanced: pipe-based IPC configuration
# LLM_WIKI_OPCODE_DIR=/tmp/llm-wiki-opencode   # IPC directory
# LLM_WIKI_OPCODE_TIMEOUT=300                  # poll timeout (seconds)
