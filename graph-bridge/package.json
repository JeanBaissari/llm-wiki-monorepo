{
  "name": "@baissari/llm-wiki-graph-bridge",
  "version": "0.2.5",
  "private": true,
  "description": "AST extraction + graph merger bridge for LLM Wiki — unifies wikilink and code-structure graphs",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/*.test.js || echo '# tests 0'",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@baissari/llm-wiki-shared-types": "file:../../packages/shared-types",
    "graphology": "^0.26.0"
  },
  "peerDependencies": {
    "@sentropic/graphify": ">=0.17.0"
  },
  "peerDependenciesMeta": {
    "@sentropic/graphify": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0"
  }
}
