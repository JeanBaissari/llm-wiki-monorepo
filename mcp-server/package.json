{
  "name": "mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone MCP server for LLM Wiki — 8 tools working directly against a wiki directory",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "llm-wiki-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "graph-engine": "*",
    "sql.js": "^1.10.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.19.43",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  }
}
